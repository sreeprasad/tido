{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tido",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": { "enabled": true },
  "vars": {
    "ROOM_IDLE_MINUTES": "10",
    "ROOM_DEFAULT_MINUTES": "60",
    "ROOM_MAX_MINUTES": "180"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "SHARD", "class_name": "ShardDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "ShardDO"] }
  ]
}
